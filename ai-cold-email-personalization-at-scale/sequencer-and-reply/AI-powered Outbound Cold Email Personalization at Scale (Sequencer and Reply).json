  "name": "AI-powered Outbound Cold Email Personalization at Scale (Sequencer and Reply)",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate a follow up based on the given data,\ncold_email_body : {{ $json.threads[0].snippet }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=I'm one of the founders at Verve Outbound. We're a 2-person B2B SaaS team and we've been doing cold outreach manually, but it doesn't scale and generic \"I saw your profile\" openers get zero replies.\n\nYou will be provided with the cold email we sent to each prospect after scrapping their company site, we pulls one real detail worth mentioning, and writes a short opening line referencing it — then queues it into our email sequencer without blasting everything at once and getting us flagged as spam.\n\nIf a prospect's site gives nothing usable,we just skip them and stores the reason of why.\n\nWhat we Want : Generate follow-up emails to send again to the prospect if he/she haven't replied yet.\n\n\nOutput Fromat:-\n{\"email_body\"} : {\"body of the email\"}\n"
        }
      },
