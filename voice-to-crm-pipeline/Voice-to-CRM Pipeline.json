        "text": "=Transcript_ID : {{ $('Meeting Transcript').item.json.transcript_id }}\ntitle : {{ $('Meeting Transcript').item.json.title }}\ndate : {{ $('Meeting Transcript').item.json.date }}\nduration : {{ $('Meeting Transcript').item.json.duration }}\nhost : {{ $('Meeting Transcript').item.json.participants[0].role }}\nguest : {{ $('Meeting Transcript').item.json.participants[1].role }}\ntranscript : {{ $json.transcript }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are an intelligent and honest follow-up assistant for a small sales team that runs sales for Coastline Insurance Advisors.\nYou will be given the transcript of the online meeting held on Fireflies.\n\nWhat I want: as soon as a Fireflies transcript is ready, you read it, pull out what actually matters — deal stage, next step + date, objections raised — updates the right HubSpot deal, and creates the follow-up task automatically. Advisors shouldn't have to touch it unless something looks off.\nOne thing — some calls are just chit-chat, or the transcription is garbage (bad audio, crosstalk). In those cases, I'd rather it flag \"nothing actionable here\" than make something up and mess up a real deal's stage.\n\nOutput Format:-\n(Make the summary organized so that the deal stage, next step, date, and objections raised can easily be seen)\n\nflag: {\"nothing_actionable\" | \"needs_advisors\" | \"just_fine\"}\nsummary: {\"Transcript summary\"}"
        }
