    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.response || $input.first().json.text || '';\n\nlet flag = 'no_match';\nlet description = '';\n\n// Handle JSON wrapped in code blocks\nconst cleaned = raw.replace(/```json\\n?|```/g, '').trim();\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  flag = parsed.flag || 'no_match';\n  description = parsed.description || '';\n} catch (e) {\n  // Fallback to regex if JSON.parse fails\n  const flagMatch = raw.match(/\"flag\"\\s*:\\s*\"([^\"]+)\"/);\n  if (flagMatch) flag = flagMatch[1];\n  \n  // Multi-line safe description extraction\n  const descMatch = raw.match(/\"description\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/);\n  if (descMatch) description = descMatch[1].replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"');\n}\n\nconst escalate = flag !== 'usual_query';\n\nreturn [{ json: { flag, description, escalate, raw_output: raw } }];"
      },
